{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"name": "${mod_name}",
	"version": "${mod_version}",

	"description": "AFK trade with villagers",
	"authors": [
		"${mod_author}"
	],
	"contact": {
		"homepage": "${mod_homepage}",
		"issues": "${mod_issue_tracker}",
		"sources": "${mod_sources}"
	},

	"license": "0BSD",
	"icon": "assets/autotrade/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.github.sebseb7.autotrade.AutoTrade"
		],
		"modmenu": [
			"com.github.sebseb7.autotrade.compat.modmenu.ModMenuImpl"
		]
	},

	"mixins": [
		"autotrade.mixins.json"
	],

	"depends": {
		"minecraft": "${minecraft_dependency}",
		"malilib": ">=${malilib_version}",
		"fabric-api": "${fabric_api_dependency}"
	}
}
